Algoritmo "Exemplo feito pelo Dollynho sobre procedimentos"

Var

nome1, nome2,nome3, nome4: caracter

procedimento saudacoes(N1: caracter)
 inicio
   escreva("Bom dia!", N1)
   
   fimprocedimento

Inicio

nome1 <- "Joao..."
saudacoes (nome1)

nome2 <- "Bianca.."
saudacoes (nome2)

nome3 <- "Thawan..."
saudacoes (nome3)

nome4 <- "Giovana..."
saudacoes (nome4)


Fimalgoritmo